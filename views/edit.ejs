<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>編集 - BookMark.com</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">✏️ ブックマークの編集</h5>
            </div>
            <div class="card-body">
                <form action="/edit/<%= b.id %>" method="POST">
                    <div class="mb-3">
                        <label class="form-label text-muted small">URL</label>
                        <input type="url" name="url" class="form-control" value="<%= b.url %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">タイトル</label>
                        <input type="text" name="title" class="form-control" value="<%= b.title %>" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small">タグ</label>
                        <input type="text" name="tag" class="form-control" value="<%= b.tag %>">
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/" class="btn btn-secondary">キャンセル</a>
                        <button type="submit" class="btn btn-primary">更新する</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>